<?xml version="1.0" encoding="UTF-8"?>
<!-- OTOMATIK ÜRETİLDİ: php site/private/tools/build.php (kaynak: routes.php, redirects.php). Elle düzenlemeyin. -->
<configuration>
  <system.webServer>

    <defaultDocument enabled="true">
      <files>
        <remove value="index.php" />
        <add value="index.php" />
      </files>
    </defaultDocument>

    <rewrite>
      <rules>
        <rule name="Apex alan adi -&gt; www (https)" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
            <add input="{HTTP_HOST}" pattern="^academyizmir\.com$" />
          </conditions>
          <action type="Redirect" url="https://www.academyizmir.com/{R:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="http -&gt; https" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
            <add input="{HTTPS}" pattern="off" />
            <add input="{HTTP_HOST}" pattern="^(www\.)?academyizmir\.com$" />
          </conditions>
          <action type="Redirect" url="https://www.academyizmir.com/{R:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="index.php ve index.html -&gt; /" stopProcessing="true">
          <match url="^index\.(php|html)$" />
          <action type="Redirect" url="/" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Eski adres: /hakkimizda.html" stopProcessing="true">
          <match url="^hakkimizda\.html/?$" />
          <action type="Redirect" url="/hakkimizda" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Eski adres: /iletisim.aspx" stopProcessing="true">
          <match url="^iletisim\.aspx/?$" />
          <action type="Redirect" url="/iletisim" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Eski adres: /kadromuz.html" stopProcessing="true">
          <match url="^kadromuz\.html/?$" />
          <action type="Redirect" url="/sanatci-kadromuz" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Eski adres: /kazananlar.html" stopProcessing="true">
          <match url="^kazananlar\.html/?$" />
          <action type="Redirect" url="/kazananlarimiz" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Eski adres: /kazanan-listesi.html" stopProcessing="true">
          <match url="^kazanan\-listesi\.html/?$" />
          <action type="Redirect" url="/kazananlarimiz" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Eski adres: /etkinlikler.html" stopProcessing="true">
          <match url="^etkinlikler\.html/?$" />
          <action type="Redirect" url="/duyurular" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Eski adres: /bolumler.html" stopProcessing="true">
          <match url="^bolumler\.html/?$" />
          <action type="Redirect" url="/atolyeler" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Eski adres: /tiyatro.html" stopProcessing="true">
          <match url="^tiyatro\.html/?$" />
          <action type="Redirect" url="/atolyeler" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Eski adres: /yaratici-drama.html" stopProcessing="true">
          <match url="^yaratici\-drama\.html/?$" />
          <action type="Redirect" url="/atolyeler" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Eski adres: /cocuklar-icin-drama.html" stopProcessing="true">
          <match url="^cocuklar\-icin\-drama\.html/?$" />
          <action type="Redirect" url="/atolyeler" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Eski adres: /ozel-yetenek-sinavi.html" stopProcessing="true">
          <match url="^ozel\-yetenek\-sinavi\.html/?$" />
          <action type="Redirect" url="/atolyeler" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Eski adres: /cocuklar-icin-bale.html" stopProcessing="true">
          <match url="^cocuklar\-icin\-bale\.html/?$" />
          <action type="Redirect" url="/atolyeler" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Eski adres: /dans.html" stopProcessing="true">
          <match url="^dans\.html/?$" />
          <action type="Redirect" url="/atolyeler" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Eski adres: /konusma-egitimi.html" stopProcessing="true">
          <match url="^konusma\-egitimi\.html/?$" />
          <action type="Redirect" url="/atolyeler" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Eski adres: /sinema-ve-dizi-oyunculugu.html" stopProcessing="true">
          <match url="^sinema\-ve\-dizi\-oyunculugu\.html/?$" />
          <action type="Redirect" url="/atolyeler" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Eski adres: /sinema-televizyon.html" stopProcessing="true">
          <match url="^sinema\-televizyon\.html/?$" />
          <action type="Redirect" url="/atolyeler" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Eski adres: /fotografcilik.html" stopProcessing="true">
          <match url="^fotografcilik\.html/?$" />
          <action type="Redirect" url="/atolyeler" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Eski adres: /muzik-egitimi.html" stopProcessing="true">
          <match url="^muzik\-egitimi\.html/?$" />
          <action type="Redirect" url="/atolyeler" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Eski adres: /resim-kurslari.html" stopProcessing="true">
          <match url="^resim\-kurslari\.html/?$" />
          <action type="Redirect" url="/atolyeler" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Eski adres: /jimnastik.html" stopProcessing="true">
          <match url="^jimnastik\.html/?$" />
          <action type="Redirect" url="/atolyeler" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Eski adres: /ozlem-baskaya.html" stopProcessing="true">
          <match url="^ozlem\-baskaya\.html/?$" />
          <action type="Redirect" url="/sanatci-kadromuz#ozlem-baskaya" redirectType="Permanent" appendQueryString="false" />
        </rule>
        <rule name="Eski adres: /ozgur-baskaya.html" stopProcessing="true">
          <match url="^ozgur\-baskaya\.html/?$" />
          <action type="Redirect" url="/sanatci-kadromuz#ozgur-baskaya" redirectType="Permanent" appendQueryString="false" />
        </rule>
        <rule name="Eski adres: /tamer-yilmaz.html" stopProcessing="true">
          <match url="^tamer\-yilmaz\.html/?$" />
          <action type="Redirect" url="/sanatci-kadromuz" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Eski adres: /asli-sinke.html" stopProcessing="true">
          <match url="^asli\-sinke\.html/?$" />
          <action type="Redirect" url="/sanatci-kadromuz" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Eski adres: /selda-uzunkaya.html" stopProcessing="true">
          <match url="^selda\-uzunkaya\.html/?$" />
          <action type="Redirect" url="/sanatci-kadromuz" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Eski adres: /yesim-turgut.html" stopProcessing="true">
          <match url="^yesim\-turgut\.html/?$" />
          <action type="Redirect" url="/sanatci-kadromuz" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Eski adres: /ozlem-gur.html" stopProcessing="true">
          <match url="^ozlem\-gur\.html/?$" />
          <action type="Redirect" url="/sanatci-kadromuz" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Eski adres: /derya-tiryaki.html" stopProcessing="true">
          <match url="^derya\-tiryaki\.html/?$" />
          <action type="Redirect" url="/sanatci-kadromuz" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Eski adres: /dilek-kutsav.html" stopProcessing="true">
          <match url="^dilek\-kutsav\.html/?$" />
          <action type="Redirect" url="/sanatci-kadromuz" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Eski adres: /firat-halavut.html" stopProcessing="true">
          <match url="^firat\-halavut\.html/?$" />
          <action type="Redirect" url="/sanatci-kadromuz" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Eski adres: /galeri.html" stopProcessing="true">
          <match url="^galeri\.html/?$" />
          <action type="Redirect" url="/galeri" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Eski adres: /galeri_bale.html" stopProcessing="true">
          <match url="^galeri_bale\.html/?$" />
          <action type="Redirect" url="/galeri" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Eski adres: /galeri_etkinlikler.html" stopProcessing="true">
          <match url="^galeri_etkinlikler\.html/?$" />
          <action type="Redirect" url="/galeri" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Eski adres: /galeri_yetenek_sinavi.html" stopProcessing="true">
          <match url="^galeri_yetenek_sinavi\.html/?$" />
          <action type="Redirect" url="/galeri" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Eski adres: /galeri_piyano.html" stopProcessing="true">
          <match url="^galeri_piyano\.html/?$" />
          <action type="Redirect" url="/galeri" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Eski adres: /galeri_resim.html" stopProcessing="true">
          <match url="^galeri_resim\.html/?$" />
          <action type="Redirect" url="/galeri" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Eski adres: /galeri_tiyatro.html" stopProcessing="true">
          <match url="^galeri_tiyatro\.html/?$" />
          <action type="Redirect" url="/galeri" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Eski adres: /galeri_yaratici_drama.html" stopProcessing="true">
          <match url="^galeri_yaratici_drama\.html/?$" />
          <action type="Redirect" url="/galeri" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Eski adres: /galeri_sene_sonu.html" stopProcessing="true">
          <match url="^galeri_sene_sonu\.html/?$" />
          <action type="Redirect" url="/galeri" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Eski adres: /egitimler" stopProcessing="true">
          <match url="^egitimler/?$" />
          <action type="Redirect" url="/atolyeler" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Eski adres: /egitmen-kadromuz" stopProcessing="true">
          <match url="^egitmen\-kadromuz/?$" />
          <action type="Redirect" url="/sanatci-kadromuz" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Eski adres: /on-basvuru" stopProcessing="true">
          <match url="^on\-basvuru/?$" />
          <action type="Redirect" url="/katilim-formu" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Sondaki egik cizgiyi kaldir" stopProcessing="true">
          <match url="^(.+)/$" />
          <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Redirect" url="/{R:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="PHP dosyasi -&gt; adres: index.php" stopProcessing="true">
          <match url="^index\.php$" />
          <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
            <add input="{THE_REQUEST}" pattern="^[A-Z]{3,9}\s/index\.php(\?|\s)" />
          </conditions>
          <action type="Redirect" url="/" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="PHP dosyasi -&gt; adres: programs.php" stopProcessing="true">
          <match url="^programs\.php$" />
          <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
            <add input="{THE_REQUEST}" pattern="^[A-Z]{3,9}\s/programs\.php(\?|\s)" />
          </conditions>
          <action type="Redirect" url="/atolyeler" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="PHP dosyasi -&gt; adres: about.php" stopProcessing="true">
          <match url="^about\.php$" />
          <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
            <add input="{THE_REQUEST}" pattern="^[A-Z]{3,9}\s/about\.php(\?|\s)" />
          </conditions>
          <action type="Redirect" url="/hakkimizda" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="PHP dosyasi -&gt; adres: faculty.php" stopProcessing="true">
          <match url="^faculty\.php$" />
          <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
            <add input="{THE_REQUEST}" pattern="^[A-Z]{3,9}\s/faculty\.php(\?|\s)" />
          </conditions>
          <action type="Redirect" url="/sanatci-kadromuz" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="PHP dosyasi -&gt; adres: winners.php" stopProcessing="true">
          <match url="^winners\.php$" />
          <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
            <add input="{THE_REQUEST}" pattern="^[A-Z]{3,9}\s/winners\.php(\?|\s)" />
          </conditions>
          <action type="Redirect" url="/kazananlarimiz" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="PHP dosyasi -&gt; adres: gallery.php" stopProcessing="true">
          <match url="^gallery\.php$" />
          <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
            <add input="{THE_REQUEST}" pattern="^[A-Z]{3,9}\s/gallery\.php(\?|\s)" />
          </conditions>
          <action type="Redirect" url="/galeri" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="PHP dosyasi -&gt; adres: announcements.php" stopProcessing="true">
          <match url="^announcements\.php$" />
          <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
            <add input="{THE_REQUEST}" pattern="^[A-Z]{3,9}\s/announcements\.php(\?|\s)" />
          </conditions>
          <action type="Redirect" url="/duyurular" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="PHP dosyasi -&gt; adres: application.php" stopProcessing="true">
          <match url="^application\.php$" />
          <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
            <add input="{THE_REQUEST}" pattern="^[A-Z]{3,9}\s/application\.php(\?|\s)" />
          </conditions>
          <action type="Redirect" url="/katilim-formu" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="PHP dosyasi -&gt; adres: contact.php" stopProcessing="true">
          <match url="^contact\.php$" />
          <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
            <add input="{THE_REQUEST}" pattern="^[A-Z]{3,9}\s/contact\.php(\?|\s)" />
          </conditions>
          <action type="Redirect" url="/iletisim" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="PHP dosyasi -&gt; adres: privacy-notice.php" stopProcessing="true">
          <match url="^privacy\-notice\.php$" />
          <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
            <add input="{THE_REQUEST}" pattern="^[A-Z]{3,9}\s/privacy\-notice\.php(\?|\s)" />
          </conditions>
          <action type="Redirect" url="/kvkk-aydinlatma-metni" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Adres -&gt; index.php" stopProcessing="true">
          <match url="^$" />
          <action type="Rewrite" url="/index.php" appendQueryString="true" />
        </rule>
        <rule name="Adres -&gt; programs.php" stopProcessing="true">
          <match url="^atolyeler$" />
          <action type="Rewrite" url="/programs.php" appendQueryString="true" />
        </rule>
        <rule name="Adres -&gt; about.php" stopProcessing="true">
          <match url="^hakkimizda$" />
          <action type="Rewrite" url="/about.php" appendQueryString="true" />
        </rule>
        <rule name="Adres -&gt; faculty.php" stopProcessing="true">
          <match url="^sanatci\-kadromuz$" />
          <action type="Rewrite" url="/faculty.php" appendQueryString="true" />
        </rule>
        <rule name="Adres -&gt; winners.php" stopProcessing="true">
          <match url="^kazananlarimiz$" />
          <action type="Rewrite" url="/winners.php" appendQueryString="true" />
        </rule>
        <rule name="Adres -&gt; gallery.php" stopProcessing="true">
          <match url="^galeri$" />
          <action type="Rewrite" url="/gallery.php" appendQueryString="true" />
        </rule>
        <rule name="Adres -&gt; announcements.php" stopProcessing="true">
          <match url="^duyurular$" />
          <action type="Rewrite" url="/announcements.php" appendQueryString="true" />
        </rule>
        <rule name="Adres -&gt; application.php" stopProcessing="true">
          <match url="^katilim\-formu$" />
          <action type="Rewrite" url="/application.php" appendQueryString="true" />
        </rule>
        <rule name="Adres -&gt; contact.php" stopProcessing="true">
          <match url="^iletisim$" />
          <action type="Rewrite" url="/contact.php" appendQueryString="true" />
        </rule>
        <rule name="Adres -&gt; privacy-notice.php" stopProcessing="true">
          <match url="^kvkk\-aydinlatma\-metni$" />
          <action type="Rewrite" url="/privacy-notice.php" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <remove name="X-Frame-Options" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <remove name="Permissions-Policy" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
      </customHeaders>
    </httpProtocol>

    <httpErrors>
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/404.php" responseMode="ExecuteURL" />
    </httpErrors>

    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".mp4" />
      <mimeMap fileExtension=".mp4" mimeType="video/mp4" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>

    <urlCompression doStaticCompression="true" />

    <security>
      <requestFiltering>
        <hiddenSegments>
          <remove segment="private" />
          <add segment="private" />
          <remove segment=".git" />
          <add segment=".git" />
        </hiddenSegments>
        <fileExtensions>
          <remove fileExtension=".json" />
          <add fileExtension=".json" allowed="false" />
          <remove fileExtension=".md" />
          <add fileExtension=".md" allowed="false" />
          <remove fileExtension=".example" />
          <add fileExtension=".example" allowed="false" />
          <remove fileExtension=".log" />
          <add fileExtension=".log" allowed="false" />
          <remove fileExtension=".bak" />
          <add fileExtension=".bak" allowed="false" />
          <remove fileExtension=".sql" />
          <add fileExtension=".sql" allowed="false" />
          <remove fileExtension=".ini" />
          <add fileExtension=".ini" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

  </system.webServer>

  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
